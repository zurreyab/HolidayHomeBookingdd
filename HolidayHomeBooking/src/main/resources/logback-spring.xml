<?xml version="1.0" encoding="UTF-8"?>
<configuration>

   <!-- <property name="APP_NAME" value="./logs"/>-->
    <!--<property  name="APP_NAME"  source="spring.application.name" />-->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd hh:mm: a} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>./logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>./logs/application-%d{dd-MM-YYYY}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{dd/MM/yyyy HH:mm:ss.z} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

  <!-- <logger name="com.holidaybookingproject.HolidayHomeBooking" level="INFO">
        <appender-ref ref="FILE"/>
    </logger>-->
    <logger name="com.holidaybookingproject.HolidayHomeBooking.controller" level="TRACE">
        <appender-ref ref="FILE"/>

    </logger>

    <shutdownHook  class="ch.qos.logback.core.hook.DefaultShutdownHook" />

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>


</configuration>